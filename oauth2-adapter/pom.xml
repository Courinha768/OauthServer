<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.courinha.oauth</groupId>
        <artifactId>oauth2-core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>oauth2-adapter</artifactId>
    <packaging>pom</packaging>
    <name>oauth2-adapter</name>
    <description>
        Aggregator for the adapters. Each adapter is its own artifact so that a deployment can
        pick, for example, the JWT generator without the opaque one, or a database repository
        without the in-memory one. oauth2-boot chooses by declaring dependencies.
    </description>

    <modules>
        <module>oauth2-adapter-in-web</module>
        <module>oauth2-adapter-out-persistence-file</module>
        <module>oauth2-adapter-out-persistence-inmemory</module>
        <module>oauth2-adapter-out-token-opaque</module>
        <module>oauth2-adapter-out-token-jwt</module>
        <module>oauth2-adapter-out-secret-bcrypt</module>
        <module>oauth2-adapter-out-time-system</module>
        <module>oauth2-adapter-out-policy-fixed-lifetime</module>
    </modules>

</project>
