<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.courinha.oauth</groupId>
        <artifactId>oauth2-core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>oauth2-domain</artifactId>
    <name>oauth2-domain</name>
    <description>The hexagon core: OAuth2 domain model, rules and error taxonomy. No framework dependencies.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-framework-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.springframework*:*</exclude>
                                        <exclude>jakarta*:*</exclude>
                                    </excludes>
                                    <message>
                                        oauth2-domain must stay free of framework dependencies. If a type here
                                        needs Spring or jakarta.*, it belongs in an outer module.
                                        Lombok is permitted: it is a compile-time processor with provided
                                        scope, so it leaves no trace in the runtime classpath.
                                    </message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
