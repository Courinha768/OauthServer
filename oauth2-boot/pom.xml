<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.courinha.oauth</groupId>
        <artifactId>oauth2-core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>oauth2-boot</artifactId>
    <name>oauth2-boot</name>
    <description>Spring Boot composition root: wires adapters to ports and starts the server.</description>

    <dependencies>
        <!--
          This is the mix-and-match point. Swapping an adapter is a change to this list and
          nothing else: drop the in-memory repositories for a JPA module, or the opaque
          generator for the JWT one, without touching domain or application code.

          Both token generators are included here on purpose, so the format can be chosen at
          runtime by configuration rather than at build time.
        -->
        <dependency>
            <groupId>com.courinha.oauth</groupId>
            <artifactId>oauth2-adapter-in-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.courinha.oauth</groupId>
            <artifactId>oauth2-adapter-out-persistence-inmemory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.courinha.oauth</groupId>
            <artifactId>oauth2-adapter-out-token-opaque</artifactId>
        </dependency>
        <dependency>
            <groupId>com.courinha.oauth</groupId>
            <artifactId>oauth2-adapter-out-token-jwt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.courinha.oauth</groupId>
            <artifactId>oauth2-adapter-out-secret-bcrypt</artifactId>
        </dependency>
        <dependency>
            <groupId>com.courinha.oauth</groupId>
            <artifactId>oauth2-adapter-out-time-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.courinha.oauth</groupId>
            <artifactId>oauth2-adapter-out-policy-fixed-lifetime</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Architectural boundary rules, asserted against the compiled classes. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Declared here and nowhere else: applying this plugin to the library
              modules would make them try (and fail) to repackage a boot jar.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
