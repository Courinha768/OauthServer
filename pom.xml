<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.courinha.oauth</groupId>
    <artifactId>oauth2-core</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>oauth2-core</name>
    <description>OAuth2 Authorization Server (RFC 6749) built on a hexagonal architecture</description>

    <developers>
        <developer>
            <id>courinha</id>
            <name>courinha</name>
            <email>antoniocourinha768@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <modules>
        <module>oauth2-domain</module>
        <module>oauth2-application</module>
        <module>oauth2-adapter</module>
        <module>oauth2-boot</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!--
          Must be a release that understands the JDK's class file version. ArchUnit 1.4.0
          silently imports zero classes from Java 25 bytecode (major version 69), which makes
          every rule fail as "empty" rather than as a violation.
        -->
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!--
              Each adapter is version-managed individually so that oauth2-boot can depend on
              exactly the ones it wants and leave the rest off the classpath entirely.
            -->
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-in-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-out-persistence-inmemory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-out-persistence-file</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-out-token-opaque</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-out-token-jwt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-out-secret-bcrypt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-out-time-system</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.courinha.oauth</groupId>
                <artifactId>oauth2-adapter-out-policy-fixed-lifetime</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                      Declared explicitly rather than relying on classpath discovery:
                      javac no longer runs annotation processors found on the classpath
                      by default on recent JDKs.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <!--
          provided scope: Lombok is a compile-time annotation processor and must not
          reach the runtime classpath or the repackaged boot jar.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!--
          JUnit 5 is inherited by every module, including oauth2-domain and
          oauth2-application, which is what lets the inner hexagon be tested
          without Spring anywhere on the classpath.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
